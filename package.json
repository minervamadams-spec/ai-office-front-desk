{
  "name": "ai-office-front-desk",
  "productName": "AI Office Front Desk",
  "version": "0.15.10",
  "private": true,
  "license": "UNLICENSED",
  "description": "A local-first, installer-owned desktop work desk.",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:all": "electron-forge make --arch=arm64 && electron-forge make --arch=x64",
    "publish": "electron-forge publish",
    "publish:all": "electron-forge publish --arch=arm64 && electron-forge publish --arch=x64",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pretest:e2e": "electron-forge package",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@electron-forge/publisher-github": "^7.11.2",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^32.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "fast-xml-parser": "^5.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "update-electron-app": "^3.3.0"
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
